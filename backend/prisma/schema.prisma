generator client {
  provider = "prisma-client-js"
  // "native" resolves to the engine matching the platform Prisma runs on, so the same
  // schema works on Alpine and Debian-based images. Hardcoding "linux-musl" here pinned
  // the client to the musl engine and broke every Debian-based image, because
  // libquery_engine-linux-musl links against libssl.so.1.1 which those images lack.
  // Add explicit targets here only if you need a prebuilt client for another platform,
  // and generate it in an image that matches the runtime.
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  username     String?       @unique
  // scrypt hash ("scrypt$N$r$p$salt$hash"). Only populated in AUTH_MODE=local; null for Supabase users.
  passwordHash String?       @map("password_hash")
  isActive     Boolean       @default(true)
  lastLoginAt  DateTime?     @map("last_login_at")
  name         String?
  avatar       String?
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  alerts       Alert[]
  monitors     Monitor[]
  statusPages  StatusPage[]
  subscription Subscription?

  @@map("users")
}

model Monitor {
  id              String           @id @default(uuid())
  name            String
  url             String
  method          String           @default("GET")
  headers         Json?            @default("{}")
  body            String?
  interval        Int              @default(300)
  timeout         Int              @default(30)
  expectedStatus  Int?             @map("expected_status")
  expectedKeyword String?          @map("expected_keyword")
  isActive        Boolean          @default(true) @map("is_active")
  isPaused        Boolean          @default(false) @map("is_paused")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  userId          String           @map("user_id")
  region          String           @default("global")

  // ── PulseOps detection settings ────────────────────────────────────────────
  latencyThresholdMs     Int      @default(1000) @map("latency_threshold_ms")
  failureThreshold       Int      @default(3) @map("failure_threshold")
  latencyBreachThreshold Int      @default(3) @map("latency_breach_threshold")
  recoveryThreshold      Int      @default(2) @map("recovery_threshold")

  // ── Incident state-machine counters (mutated only by the incident engine, under a row lock)
  consecutiveFailures Int       @default(0) @map("consecutive_failures")
  consecutiveSlow     Int       @default(0) @map("consecutive_slow")
  consecutiveSuccess  Int       @default(0) @map("consecutive_success")
  consecutiveFast     Int       @default(0) @map("consecutive_fast")
  lastCheckedAt       DateTime? @map("last_checked_at")

  // Demo monitors never perform network I/O; their observations are generated by the
  // simulation module and stored with observation_type = 'SIMULATED'.
  isSimulated         Boolean   @default(false) @map("is_simulated")

  incidents       Incident[]
  alerts          Alert[]
  checks          Check[]
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  statusPageItems StatusPageItem[]

  @@index([userId])
  @@index([isActive])
  @@index([isPaused])
  @@index([isSimulated])
  @@map("monitors")
}

model Check {
  id           String   @id @default(uuid())
  monitorId    String   @map("monitor_id")
  status       String
  statusCode   Int?     @map("status_code")
  responseTime Int      @map("response_time")
  error        String?
  checkedAt    DateTime @default(now()) @map("checked_at")
  region       String   @default("global")

  // ── PulseOps observation metadata ──────────────────────────────────────────
  // success: the response satisfied the monitor's validation rules (status + keyword).
  success         Boolean  @default(true)
  // REAL (made by the hardened executor) or SIMULATED (generated by the demo module).
  observationType String   @default("REAL") @map("observation_type")
  // HTTP_ERROR | TIMEOUT | NETWORK | TLS | BLOCKED | VALIDATION | RESPONSE_TOO_LARGE | UNKNOWN (null on success)
  errorCategory   String?  @map("error_category")

  monitor      Monitor  @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  evidence     IncidentEvidence[]

  @@index([monitorId])
  @@index([checkedAt])
  @@index([status])
  @@index([monitorId, checkedAt(sort: Desc)], map: "idx_checks_monitor_checked_at")
  @@map("checks")
}

model Alert {
  id         String    @id @default(cuid())
  monitorId  String    @map("monitor_id")
  userId     String    @map("user_id")
  type       String
  status     String    @default("triggered")
  message    String
  details    Json?
  sentAt     DateTime  @default(now()) @map("sent_at")
  resolvedAt DateTime? @map("resolved_at")
  monitor    Monitor   @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([monitorId])
  @@index([userId])
  @@index([status])
  @@index([sentAt])
  @@map("alerts")
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique @map("user_id")
  stripeCustomerId     String    @unique @map("stripe_customer_id")
  stripeSubscriptionId String?   @unique @map("stripe_subscription_id")
  stripePriceId        String?   @map("stripe_price_id")
  status               String    @default("free")
  plan                 String    @default("free")
  currentPeriodStart   DateTime? @map("current_period_start")
  currentPeriodEnd     DateTime? @map("current_period_end")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model StatusPage {
  id          String           @id @default(cuid())
  name        String
  slug        String           @unique
  description String?
  isPublic    Boolean          @default(true) @map("is_public")
  logo        String?
  brandColor  String           @default("#3b82f6") @map("brand_color")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  userId      String           @map("user_id")
  items       StatusPageItem[]
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("status_pages")
}

model StatusPageItem {
  id           String     @id @default(cuid())
  statusPageId String     @map("status_page_id")
  monitorId    String     @map("monitor_id")
  displayName  String?    @map("display_name")
  order        Int        @default(0)
  monitor      Monitor    @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  statusPage   StatusPage @relation(fields: [statusPageId], references: [id], onDelete: Cascade)

  @@unique([statusPageId, monitorId])
  @@map("status_page_items")
}

/// An incident is opened and resolved only by the deterministic engine in @pulseops/core.
model Incident {
  id                String    @id @default(uuid()) @db.Uuid
  monitorId         String    @map("monitor_id")
  /// AVAILABILITY | LATENCY
  type              String
  /// OPEN | RESOLVED
  status            String    @default("OPEN")
  /// REAL | SIMULATED (copied from the monitor at open time)
  observationType   String    @default("REAL") @map("observation_type")
  triggerReason     String    @map("trigger_reason")
  /// Snapshot of the rule that fired: {rule, consecutiveRequired, latencyThresholdMs, recoveryRequired, ...}
  triggerRule       Json      @map("trigger_rule")
  /// checked_at of the FIRST check in the triggering streak (when the problem was first observed)
  startedAt         DateTime  @map("started_at")
  /// When the engine changed state to OPEN (>= startedAt)
  openedAt          DateTime  @map("opened_at")
  /// checked_at of the first check in the recovery streak
  recoveryStartedAt DateTime? @map("recovery_started_at")
  /// When the engine changed state to RESOLVED
  resolvedAt        DateTime? @map("resolved_at")
  resolutionReason  String?   @map("resolution_reason")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  monitor  Monitor            @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  evidence IncidentEvidence[]
  events   IncidentEvent[]

  @@index([openedAt(sort: Desc)], map: "idx_incidents_opened_at")
  @@index([monitorId, openedAt(sort: Desc)], map: "idx_incidents_monitor_opened_at")
  @@map("incidents")
}

/// Links an incident to the persisted check rows that justify it.
model IncidentEvidence {
  id         String   @id @default(uuid()) @db.Uuid
  incidentId String   @map("incident_id") @db.Uuid
  checkId    String   @map("check_id")
  /// LAST_HEALTHY | TRIGGER | CONTINUING | RECOVERY
  role       String
  createdAt  DateTime @default(now()) @map("created_at")

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  // NoAction (not Cascade): retention cleanup must never silently delete evidence.
  check    Check    @relation(fields: [checkId], references: [id], onDelete: NoAction)

  @@unique([incidentId, checkId, role])
  @@index([incidentId])
  @@index([checkId])
  @@map("incident_evidence")
}

/// State transitions (OPENED / RESOLVED). occurred_at is when the engine changed state,
/// which is deliberately distinct from the checked_at of the check that caused it.
model IncidentEvent {
  id         String   @id @default(uuid()) @db.Uuid
  incidentId String   @map("incident_id") @db.Uuid
  type       String
  occurredAt DateTime @map("occurred_at")
  checkId    String?  @map("check_id")
  message    String

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, occurredAt])
  @@map("incident_events")
}
