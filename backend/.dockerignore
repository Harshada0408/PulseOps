# Build context exclusions for the backend image.
#
# Without this file, `COPY . .` in the development stage copies the host working
# tree into the image. That has two serious consequences:
#
#   1. The host's node_modules (including a host-generated Prisma client bound to
#      the host's OpenSSL) overwrites the image's, so the container fails at runtime
#      with "Prisma cannot find the required libssl system library".
#   2. The developer's real .env — database passwords, Supabase service-role keys,
#      Stripe and Resend secrets — is baked into the image layer and shipped to
#      whatever registry the image is pushed to.
#
# Excluding both here is required for correct and safe image builds.

# Secrets and local configuration
.env
.env.*
!.env.example
*.pem
*.key

# Dependencies — reinstalled inside the image
node_modules
**/node_modules
.pnpm-store

# Build output — rebuilt inside the image
dist
build
.next
*.tsbuildinfo

# Version control and CI
.git
.gitignore
.github

# Tests and coverage
coverage
.nyc_output
**/*.test.ts
**/*.spec.ts

# Editor and OS noise
.vscode
.idea
.DS_Store
Thumbs.db
*.swp
*.swo

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local databases
*.db
*.sqlite

# Documentation — not needed at runtime
*.md
!../README.md
