# Build context exclusions for the frontend image.

# Dependencies — reinstalled inside the image. Without this, the host's
# node_modules is copied over the image's and the Next.js binary goes missing.
node_modules
**/node_modules
.pnpm-store

# Build output
.next
out
dist
build
*.tsbuildinfo

# Secrets — must never end up in a published frontend image
.env
.env.*
!.env.example
*.pem
*.key

# Version control and CI
.git
.github

# Tests and coverage
coverage
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx

# Editor and OS noise
.vscode
.idea
.DS_Store
Thumbs.db
*.swp
*.swo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Documentation and local-only notes
*.md
