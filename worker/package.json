{
  "name": "pulseops-worker",
  "version": "2.0.0",
  "description": "API Monitor SaaS - Health Check Worker",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "prisma generate --schema ../backend/prisma/schema.prisma",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:ci": "jest --runInBand",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "axios": "^1.6.2",
    "dotenv": "^16.3.1",
    "node-cron": "^3.0.3",
    "resend": "^2.0.0",
    "winston": "^3.11.0",
    "@pulseops/core": "*"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.4",
    "@types/node-cron": "^3.0.11",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "eslint": "^10.5.0",
    "globals": "^15.15.0",
    "jest": "^29.7.0",
    "prisma": "5.22.0",
    "ts-jest": "^29.1.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
