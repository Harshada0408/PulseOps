# Build context exclusions for the worker image.
#
# The worker image is built from the repository root (see worker/Dockerfile) so it
# can run `npm ci` across workspaces and generate the Prisma client from the shared
# schema at backend/prisma. That means this file governs the whole repository as
# build context, not just the worker directory.
#
# The .env exclusion is the important one: without it the repository's real .env —
# database password, Supabase service-role key, Stripe and Resend secrets — is
# copied into the image by `COPY . .` and shipped with it.

# Secrets and local configuration
.env
.env.*
!.env.example
*.pem
*.key

# Dependencies — reinstalled inside the image
node_modules
**/node_modules
.pnpm-store

# Build output — rebuilt inside the image
dist
build
.next
**/dist
*.tsbuildinfo

# Version control and CI
.git
.github

# Tests and coverage
coverage
.nyc_output
**/*.test.ts
**/*.spec.ts

# Editor and OS noise
.vscode
.idea
.DS_Store
Thumbs.db
*.swp
*.swo

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local databases
*.db
*.sqlite

# Documentation and local-only notes
*.md
backup-auth-fix
release-evidence

# Docker files for other services are not needed in this image
docker-compose*.yml
nginx
scripts
