# ─────────────────────────────────────────────────────────────────────────────
# PulseOps - environment configuration
#
#   Windows / macOS / Linux:   npm run setup:env      (creates .env with a random JWT_SECRET)
#
# This file is committed. NEVER put real credentials in it. .env is git-ignored.
# Only DATABASE_URL (your local PostgreSQL) needs editing for a local run.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (MANDATORY) ─────────────────────────────────────────────────────
# PostgreSQL 14+ (16 recommended). Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Replace USER / PASSWORD / DATABASE with what you created (see README "Windows setup").
DATABASE_URL="postgresql://pulseops:CHANGE_ME@localhost:5432/pulseops"

# ── Authentication ───────────────────────────────────────────────────────────
# local    = built-in email + password accounts stored in PostgreSQL. No external service. (recommended)
# supabase = original Supabase-backed auth; then SUPABASE_* below are required.
AUTH_MODE="local"
ENABLE_SIGNUPS="true"

# Signs login tokens. MUST be secret, >= 64 characters. `npm run setup:env` generates one.
# If you copy this file by hand, generate your own:  node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=""

# ── Backend ──────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"
# Required by the env validator; only used if email alerts are enabled.
FROM_EMAIL="alerts@pulseops.local"

# Request limits (per IP). Raise AUTH_RATE_LIMIT_MAX while developing; lower it when exposed publicly.
API_RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=50
MANUAL_CHECK_RATE_LIMIT=20
MAX_MONITORS_PER_USER=50

# ── Worker (scheduler) ───────────────────────────────────────────────────────
SCHEDULER_TICK_SECONDS=5
MAX_CONCURRENT_CHECKS=10
# Checks older than this are deleted daily - except checks cited as incident evidence.
CLEANUP_DAYS=90

# ── Frontend ─────────────────────────────────────────────────────────────────
# Read by Next.js. Where the browser finds the API.
NEXT_PUBLIC_API_URL="http://localhost:3001"

# ── OPTIONAL: AI investigation assistant ─────────────────────────────────────
# Off by default. PulseOps works fully without it. Any OpenAI-compatible
# /chat/completions endpoint can be used. Only sanitised evidence is ever sent.
AI_PROVIDER="none"
# AI_PROVIDER="openai-compatible"
# AI_BASE_URL="https://api.openai.com/v1"
# AI_API_KEY=""
# AI_MODEL=""

# ── OPTIONAL: email alerts ───────────────────────────────────────────────────
ENABLE_EMAILS="false"
# RESEND_API_KEY=""

# ── OPTIONAL: Supabase (only when AUTH_MODE="supabase") ──────────────────────
# SUPABASE_URL="https://[project-ref].supabase.co"
# SUPABASE_ANON_KEY=""
# SUPABASE_SERVICE_ROLE_KEY=""

# ── Billing (leave off; not part of PulseOps) ────────────────────────────────
ENABLE_BILLING="false"
